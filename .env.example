# Upster environment configuration.
# Copy this file to .env and fill in the values for your machine.

# Host directory mounted into the container at /workspaces.
# It must contain the repositories you register as pills.
UPSTER_HOST_WORKSPACE=

# Dashboard listen port.
UPSTER_PORT=

# Host interface the dashboard port is published on.
# Defaults to 127.0.0.1 so the dashboard stays loopback-only.
# For remote access, keep loopback and use Tailscale HTTPS (bun run tailscale:setup).
# Setting 0.0.0.0 exposes the dashboard directly and disables the local password
# path, so every client must pair. Discouraged - only behind a TLS proxy.
UPSTER_BIND_HOST=

# Directory where Upster stores its local data inside the container.
# Capsules (frozen, isolated snapshots of a pill source used for deployment) are
# stored under <UPSTER_DATA_DIR>/capsules/<pillId>/<capsuleId>.
UPSTER_DATA_DIR=

# Comma separated container paths Upster is allowed to run pills from.
UPSTER_WORKSPACE_ROOTS=

# Comma separated allowlist of executables pills may run, matched exactly by
# bare name or full path. Leave empty to allow any executable.
# This also gates the package manager used when a capsule build installs
# dependencies, so include the installers you rely on (bun, npm, pnpm, yarn).
# Example: bun,node,npm,pnpm,python3
UPSTER_ALLOWED_COMMANDS=

# App port range, metrics port range, capsule retention, dashboard origin, and
# the cloudflared binary path are configured in the dashboard under Runtime
# settings and stored in the database. They are not set here.

# Comma separated origins accepted by server function CSRF fallback checks.
# Example: https://<magic-dns-name>:8443
UPSTER_ALLOWED_ORIGINS=

# Trust x-forwarded-* headers from the local Tailscale serve proxy.
# Set to true only when Upster is behind a trusted local proxy.
UPSTER_TRUST_PROXY=

# Host directory where bun run tailscale:setup writes status.json.
# Docker mounts this directory read-only at /tailscale.
UPSTER_TAILSCALE_DIR=

# Container path for the Tailscale status JSON. Docker compose sets this to
# /tailscale/status.json.
UPSTER_TAILSCALE_STATUS_FILE=

# Force the Secure flag on the session cookie. Set to true when serving over
# HTTPS behind a proxy that does not forward the x-forwarded-proto header.
UPSTER_SECURE_COOKIES=

# Secret used to sign session cookies. Must be at least 16 characters.
# Leave empty to generate and persist one automatically.
UPSTER_SESSION_SECRET=

# libSQL connection string. Optional: defaults to the bundled libSQL service
# (http://db:8080) in Docker, or a local file otherwise.
DATABASE_URL=

# libSQL auth. Generate a keypair and token with: bun run db:credentials
# SQLD_AUTH_JWT_KEY goes to the db service, DATABASE_AUTH_TOKEN to the dashboard.
# Leave both empty to run the database without authentication.
SQLD_AUTH_JWT_KEY=
DATABASE_AUTH_TOKEN=
